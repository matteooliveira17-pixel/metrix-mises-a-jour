@echo off
rem ============================================================
rem  Metrix - mise a jour 1.3
rem  Double-cliquez sur ce fichier pour mettre Metrix a jour.
rem  (Sur Mac : Metrix > Fichier > Installer une mise a jour...)
rem METRIX-VERSION 1.3
rem ============================================================
setlocal
set "TARGET="
for %%D in (
  "%~dp0"
  "%~dp0Metrix\"
  "%USERPROFILE%\Documents\Metrix\"
  "%USERPROFILE%\OneDrive\Documents\Metrix\"
  "%USERPROFILE%\Desktop\Metrix\"
  "%USERPROFILE%\OneDrive\Desktop\Metrix\"
  "%USERPROFILE%\OneDrive\Bureau\Metrix\"
  "%USERPROFILE%\Downloads\Metrix\"
) do if not defined TARGET if exist "%%~Dapp\index.html" set "TARGET=%%~D"

if not defined TARGET (
  echo.
  echo  Dossier Metrix introuvable.
  echo  Copiez ce fichier dans le dossier "Metrix" ^(celui qui contient Metrix.cmd^),
  echo  puis double-cliquez de nouveau dessus.
  echo.
  pause
  exit /b 1
)

set "TMPF=%TEMP%\metrix-mise-a-jour.html"
certutil -f -decode "%~f0" "%TMPF%" >nul
if errorlevel 1 (
  echo.
  echo  Le fichier de mise a jour est abime. Telechargez-le de nouveau.
  echo.
  pause
  exit /b 1
)
copy /y "%TARGET%app\index.html" "%TARGET%app\index-precedent.html" >nul
copy /y "%TMPF%" "%TARGET%app\index.html" >nul
del "%TMPF%" >nul 2>&1

echo.
echo  Metrix est a jour : version 1.3.
echo  Dossier : %TARGET%
echo  Si Metrix est ouvert, fermez-le puis relancez-le.
echo  Vos metres, ouvrages et reglages sont conserves.
echo.
pause
exit /b 0

