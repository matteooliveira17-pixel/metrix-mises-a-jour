@echo off
rem ============================================================
rem  Metrix - mise a jour 1.7
rem  Double-cliquez sur ce fichier pour mettre Metrix a jour.
rem  (Sur Mac : Metrix > Fichier > Installer une mise a jour...)
rem METRIX-VERSION 1.7
rem ============================================================
setlocal
title Mise a jour de Metrix 1.7
set "SRC=%TEMP%\metrix-mise-a-jour.html"
certutil -f -decode "%~f0" "%SRC%" >nul 2>&1
if not exist "%SRC%" goto abime

set "FOUND=0"
set "DONE=0"
echo.
echo  Recherche du dossier Metrix...
rem 1) a cote de ce fichier
call :try "%~dp0"
call :try "%~dp0Metrix"
call :try "%~dp0.."
rem 2) dans les dossiers habituels, sous-dossiers compris (ex. Telechargements\Metrix-Windows\Metrix)
for %%R in ("%USERPROFILE%\Desktop" "%USERPROFILE%\Documents" "%USERPROFILE%\Downloads" "%OneDrive%" "%USERPROFILE%\OneDrive") do call :search "%%~R"
del "%SRC%" >nul 2>&1

if "%FOUND%"=="0" goto introuvable
echo.
if "%DONE%"=="0" (echo  Metrix etait deja en version 1.7.) else (echo  Metrix est a jour : version 1.7.)
echo  Si Metrix est ouvert, fermez-le puis relancez-le.
echo  Vos metres, ouvrages et reglages sont conserves.
echo.
pause
exit /b 0

:introuvable
echo.
echo  Dossier Metrix introuvable.
echo  Copiez ce fichier dans le dossier "Metrix" (celui qui contient Metrix.cmd),
echo  puis double-cliquez de nouveau dessus.
echo.
pause
exit /b 1

:abime
echo.
echo  Le fichier de mise a jour n'a pas pu etre lu.
echo  Il a peut-etre ete bloque par l'antivirus : utilisez plutot le zip
echo  "Metrix-mise-a-jour-1.7.zip".
echo.
pause
exit /b 1

rem ---- cherche Metrix.cmd dans un dossier et ses sous-dossiers ----
:search
if "%~1"=="" exit /b
if not exist "%~1\" exit /b
for /f "delims=" %%F in ('dir /s /b /a-d "%~1\Metrix.cmd" 2^>nul') do call :try "%%~dpF"
exit /b

rem ---- met a jour le dossier %1 s'il s'agit bien d'un dossier Metrix ----
:try
set "D=%~f1"
if not "%D:~-1%"=="\" set "D=%D%\"
if not exist "%D%Metrix.cmd" exit /b
if not exist "%D%app\index.html" exit /b
set "FOUND=1"
fc /b "%SRC%" "%D%app\index.html" >nul 2>&1
if not errorlevel 1 exit /b
copy /y "%D%app\index.html" "%D%app\index-precedent.html" >nul 2>&1
copy /y "%SRC%" "%D%app\index.html" >nul 2>&1
if errorlevel 1 goto tryfail
set "DONE=1"
echo  Mis a jour : %D%
exit /b
:tryfail
echo  Impossible d'ecrire dans : %D%
echo  (fermez Metrix et reessayez)
exit /b

